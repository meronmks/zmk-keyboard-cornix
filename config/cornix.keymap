#include "zmk-helpers/helper.h"
#include "includes/cornix54.h"
#include "includes/jis_keys.h"
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/ext_power.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>

#define TAPPING_TERM 250
#define QUICK_TAP    200

#define BASE     0
#define WIN      1
#define LOWER    2
#define MOUSE_BT 3
#define ADJUST   4
#define NAVI     5
#define FN       6
#define DEBUG    7
#define JIS_SYM  8
#define JIS_MODE 9

#define ZMK_POINTING_DEFAULT_SCRL_VAL 15

/ {
    behaviors {
        lt: layer_tap {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            bindings = <&mo>, <&kp>;
            flavor = "hold-preferred";
            tapping-term-ms = <TAPPING_TERM>;
            quick-tap-ms = <QUICK_TAP>;
        };

        // JIS数字行: US/JISでShiftバリアントが異なるキーをmod-morphで補正
        jis_n2: jis_n2 {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp N2>, <&kp JA_DQT>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };
        jis_n6: jis_n6 {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp N6>, <&kp JA_AMPR>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };
        jis_n7: jis_n7 {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp N7>, <&kp JA_QUOT>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };
        jis_n8: jis_n8 {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp N8>, <&kp JA_LPRN>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };
        jis_n9: jis_n9 {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp N9>, <&kp JA_RPRN>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        // JA_GRV(バッククォート)はLS(LBKT)なので、Shift+JA_GRVがLS(LS(LBKT))=LS(LBKT)になる問題をmod-morphで解消
        jis_grv: jis_grv {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp JA_GRV>, <&kp JA_TILD>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        // JIS記号行: Shiftバリアントを明示定義
        jis_semi: jis_semi {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp SEMI>, <&kp JA_PLUS>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };
        jis_minus: jis_minus {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp MINUS>, <&kp JA_EQL>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };
        jis_coln: jis_coln {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp JA_COLN>, <&kp JA_ASTR>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };
    };

    conditional_layers {
        compatible = "zmk,conditional-layers";

        // LOWER + MOUSE_BT → ADJUST
        adjust_layer {
            if-layers = <MOUSE_BT LOWER>;
            then-layer = <ADJUST>;
        };

    };

    combos {
        compatible = "zmk,combos";

        // LH2 + LH1 同時押しで JIS モード on/off（同一ハーフ = cross-half 遅延なし）
        jis_toggle {
            bindings = <&tog JIS_MODE>;
            key-positions = <LH2 LH1>;
            timeout-ms = <50>;
        };

        cb_esc {
            bindings = <&kp ESC>;
            key-positions = <2 4>;
            layers = <BASE WIN>;
        };

        cb_tab {
            bindings = <&kp TAB>;
            key-positions = <14 16>;
            layers = <BASE WIN>;
        };

        cb_enter {
            bindings = <&kp RET>;
            key-positions = <19 21>;
            layers = <BASE WIN>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        // ── Layer 0: Base ──────────────────────────────────────────────────────
        // QMK Cornix v1.12 Layer 0 をベースに再現。
        // サムキー: lt FN(ESC) / lt LOWER(英数) / SPC | BSPC / lt MOUSE_BT(かな) / ENT
        // 右パームキー: ← ↓ →
        default_layer {
            display-name = "Base";
            bindings = <
&kp TAB    &kp Q     &kp W     &kp E              &kp R               &kp T                       &kp Y     &kp U                &kp I      &kp O     &kp P      &kp BSPC
&kp CAPS   &kp A     &kp S     &kp D              &kp F               &kp G                       &kp H     &kp J                &kp K      &kp L     &kp BSLH   &kp ENTER
&kp LSHFT  &kp Z     &kp X     &kp C              &kp V               &kp B        &none  &none  &kp N     &kp M                &kp COMMA  &kp DOT   &kp UP     &kp SLASH
&kp LCTRL  &kp LALT  &kp LGUI  &lt FN ESCAPE      &lt LOWER LANG2     &kp SPACE               &kp BSPC  &lt MOUSE_BT LANG1    &kp ENTER  &kp LEFT  &kp DOWN   &kp RIGHT
            >;
            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp PG_UP PG_DN>;
        };

        // ── Layer 1: Windows ─────────────────────────────────────────────────
        // 将来の Windows 向けキーリマップ用。現在は全透過。
        win_layer {
            display-name = "Windows";
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans                  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans                  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans                  &trans  &trans  &trans  &trans  &trans  &trans
            >;
            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp PG_UP PG_DN>;
        };

        // ── Layer 2: Lower ────────────────────────────────────────────────────
        // QMK Layer 1 を再現。数字 + JIS 記号。
        // 右中段の = ' [ ] は JIS モード時に ^ : @ [ になる。
        // 右パーム RP2: INT1 (JIS RO キー = \ / _)
        lower_layer {
            display-name = "Lower";
            bindings = <
&kp ESC  &kp N1  &kp N2     &kp N3  &kp N4    &kp N5                      &kp N6     &kp N7   &kp N8    &kp N9    &kp N0   &trans
&none    &none   &kp GRAVE  &none   &kp SEMI  &kp MINUS                   &kp EQUAL  &kp SQT  &kp LBKT  &kp RBKT  &trans   &trans
&trans   &none   &none      &none   &none     &none       &trans  &trans  &none      &none    &trans    &trans    &none    &trans
&trans   &trans  &trans     &trans  &trans    &trans                       &trans     &trans   &trans    &none     &none    &kp INT1
            >;
            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp PG_UP PG_DN>;
        };

        // ── Layer 3: Mouse / BT ───────────────────────────────────────────────
        // QMK Layer 2 を再現。Bluetooth 操作 + マウス移動。
        // 左列: BT_CLR / BT0 / BT1 / BT2, SwitchOut
        // 右中段: HJKL 位置にマウス移動 (← ↓ ↑ →)
        // 右上 I 位置: &tog JIS_MODE (RH1 長押し + I で JIS on/off)
        mouse_bt_layer {
            display-name = "Mouse/BT";
            bindings = <
&bt BT_CLR    &none  &none  &none      &none      &none                       &none           &none           &tog 9         &none            &kp PSCRN  &kp DEL
&bt BT_SEL 0  &none  &none  &none      &mkp MB1   &none                       &mmv MOVE_LEFT  &mmv MOVE_DOWN  &mmv MOVE_UP   &mmv MOVE_RIGHT  &none      &kp INS
&bt BT_SEL 1  &none  &none  &none      &mkp MB2   &none       &trans  &trans  &none           &none           &none          &none            &none      &none
&bt BT_SEL 2  &out OUT_TOG  &none  &trans  &trans  &trans                     &trans          &trans          &trans         &none            &none      &none
            >;
            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp PG_UP PG_DN>;
        };

        // ── Layer 4: Adjust (conditional: LOWER + MOUSE_BT) ──────────────────
        adjust_layer {
            display-name = "Adjust";
            bindings = <
&bt BT_CLR      &bt BT_SEL 0   &bt BT_SEL 1   &bt BT_SEL 2   &bt BT_SEL 3   &bt BT_SEL 4                   &none   &none  &none   &none  &none             &none
&none           &bt BT_DISC 0  &bt BT_DISC 1  &bt BT_DISC 2  &bt BT_DISC 3  &bt BT_DISC 4                  &tog 1  &to 0  &tog 9  &none  &none             &tog 1
&bt BT_CLR_ALL  &none          &none          &none          &none          &none          &trans  &trans   &none   &none  &none   &none  &ext_power EP_ON  &kp CAPS
&none           &none          &none          &none          &none          &none                            &none   &none  &none   &none  &none             &none
            >;
        };

        // ── Layer 5: Navi ─────────────────────────────────────────────────────
        // マウス移動 + スクロール + カーソル。BASE からは直接アクセスしない。
        navi_layer {
            display-name = "Navi";
            bindings = <
&none  &none  &none           &mmv MOVE_UP    &kp PAGE_UP      &kp PAGE_DOWN                   &mkp MB1  &mkp MB3  &mkp MB2  &msc SCRL_UP  &msc SCRL_DOWN  &none
&none  &none  &mmv MOVE_LEFT  &mmv MOVE_DOWN  &mmv MOVE_RIGHT  &msc SCRL_UP                    &kp LEFT  &kp DOWN  &kp UP    &kp RIGHT     &none           &none
&none  &none  &none           &none           &none            &msc SCRL_DOWN  &trans  &trans  &trans    &trans    &none     &none         &none           &none
&none  &none  &none           &none           &trans           &trans                          &none     &none     &none     &none         &none           &none
            >;
        };

        // ── Layer 6: FN ───────────────────────────────────────────────────────
        // QMK Layer 3 を再現。ファンクションキー + ナビゲーション。
        // 右中段: Home PgDn PgUp End
        // 右パーム: ← ↓ →, 右サム: RShift RCtrl RAlt
        fn_layer {
            display-name = "FN";
            bindings = <
&kp F1     &kp F2    &kp F3    &kp F4  &kp F5  &kp F6                      &kp F7     &kp F8     &kp F9     &kp F10   &kp F11   &kp F12
&none      &none     &none     &none   &none   &none                       &kp HOME   &kp PG_DN  &kp PG_UP  &kp END   &none     &none
&kp LSHFT  &none     &none     &none   &none   &none      &trans  &trans   &none      &none      &none      &none     &kp UP    &none
&kp LCTRL  &kp LALT  &kp LGUI  &trans  &trans  &trans                      &kp RSHFT  &kp RCTRL  &kp RALT   &kp LEFT  &kp DOWN  &kp RIGHT
            >;
            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp PG_UP PG_DN>;
        };

        // ── Layer 7: Debug ───────────────────────────────────────────────────
        debug_layer {
            display-name = "Debug";
            bindings = <
&bt BT_CLR  &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4                  &none        &none  &none  &none  &none  &none
&none       &none         &none         &none         &none         &none                         &none        &none  &none  &none  &none  &none
&none       &none         &none         &none         &none         &bootloader   &trans  &trans  &bootloader  &none  &none  &none  &none  &none
&none       &none         &none         &none         &none         &none                         &none        &none  &none  &none  &none  &none
            >;
        };

        // ── Layer 8: JIS Lower ───────────────────────────────────────────────
        // LOWER の JIS 版。構造は LOWER と同一、記号のみ JA_* マクロで正しく送出。
        // CAPS 位置（左端 home row）に &tog JIS_MODE: LH1 長押し中に押すと JIS 解除。
        jis_sym_layer {
            display-name = "JIS Lower";
            bindings = <
&kp ESC   &kp N1   &jis_n2    &kp N3  &kp N4    &kp N5                      &jis_n6     &jis_n7      &jis_n8      &jis_n9      &kp N0   &trans
&tog 9    &none    &jis_grv   &none   &jis_semi  &jis_minus                 &kp JA_EQL  &jis_coln    &kp JA_LBRC  &kp JA_RBRC  &trans   &trans
&trans    &none   &none       &none   &none     &none       &trans  &trans  &none       &none        &trans       &trans       &none    &trans
&trans    &trans  &trans      &trans  &trans    &trans                       &trans      &trans       &trans       &none        &none    &kp INT1
            >;
            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp PG_UP PG_DN>;
        };

        // ── Layer 9: JIS Mode ────────────────────────────────────────────────
        // JIS モードトグル。Adjust の &tog 9 または JIS Lower の CAPS 位置で on/off。
        // アクティブ時、LH1 の lt LOWER を lt JIS_SYM に差し替える。
        // アルファキーは全透過なのでタイピングへの影響なし。
        jis_mode_layer {
            display-name = "JIS";
            bindings = <
&trans  &trans  &trans  &trans  &trans               &trans                  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans               &trans                  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans               &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &lt JIS_SYM LANG2    &trans                  &trans  &trans  &trans  &trans  &trans  &trans
            >;
        };
    };
};
